# Maintainer: Uke <https://github.com/UkeHa>
pkgname=quackquacksearch-bin
pkgver=0.1.3
pkgrel=1
pkgdesc="Lightning-fast Linux file search engine, daemon, GUI and KRunner plugin (pre-built binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/UkeHa/quackquacksearch"
license=('MIT')
depends=(
    'dotnet-runtime-10.0'
    'fontconfig'
    'freetype2'
    'libx11'
    'libice'
    'libsm'
    'libxcursor'
    'libxext'
    'libxi'
    'libxrandr'
    'libxrender'
)
optdepends=(
    'krunner: Quick search integration from Alt+Space'
    'plasma-workspace: KDE Plasma integration and global hotkeys'
)
provides=('quackquacksearch')
conflicts=('quackquacksearch' 'quackquacksearch-git')
install=quackquacksearch.install

source_x86_64=(
    "quackquacksearch-${pkgver}-x64.tar.gz::https://github.com/UkeHa/quackquacksearch/releases/download/v${pkgver}/quackquacksearch-linux-x64.tar.gz"
)
source_aarch64=(
    "quackquacksearch-${pkgver}-arm64.tar.gz::https://github.com/UkeHa/quackquacksearch/releases/download/v${pkgver}/quackquacksearch-linux-arm64.tar.gz"
)
source=(
    "quackquacksearch.service"
    "quackquacksearch-gui.desktop"
    "quackquacksearch-krunner.desktop"
    "quackquacksearch.png"
    "LICENSE"
)

sha256sums_x86_64=('ea79575df978ec92986ef3b01323d6ae14185ce1177e4b1993daaac1b9f2cfc7')
sha256sums_aarch64=('ab18a9cd376806fbbe017c489c550824538e62e7994910fdb1939c66adc9ca71')
sha256sums=(
    '2edab2174e2b158008df1a302dd433d3d9d4aeb628bc63d9ec4d43c02d0ed8a0'
    '959cd2005423076376a41c2071e0a8b7ec4381a93c9ac101612ca2d41d4acf7b'
    '1c112d71d6c926ebf356a977d95ebdb4f6268d376842e3043c2cb5c6edba988a'
    'ee4d7317faa8f5cae1e60f80db0ece66e35774c924343c24bb14fa9bc3baabea'
    '6fce02aa473946ffc4c30f35011428a31a06528bab14c0e056124fa5a15eef4a'
)

package() {
    # 1. Install application libraries and binaries
    install -d "${pkgdir}/usr/lib/quackquacksearch"
    cp -r "${srcdir}/lib"/* "${pkgdir}/usr/lib/quackquacksearch/"

    # Set execute permissions on main binaries
    chmod 755 "${pkgdir}/usr/lib/quackquacksearch/cli/QuackQuackSearch.Cli"
    chmod 755 "${pkgdir}/usr/lib/quackquacksearch/daemon/QuackQuackSearch.Daemon"
    chmod 755 "${pkgdir}/usr/lib/quackquacksearch/gui/QuackQuackSearch.Gui"

    # 2. Symlinks in /usr/bin
    install -d "${pkgdir}/usr/bin"
    ln -sf "/usr/lib/quackquacksearch/cli/QuackQuackSearch.Cli" "${pkgdir}/usr/bin/qqs"
    ln -sf "/usr/lib/quackquacksearch/daemon/QuackQuackSearch.Daemon" "${pkgdir}/usr/bin/quackquacksearch-daemon"
    ln -sf "/usr/lib/quackquacksearch/gui/QuackQuackSearch.Gui" "${pkgdir}/usr/bin/quackquacksearch-gui"

    # 3. Desktop Application & KRunner plugin
    install -Dm644 "${srcdir}/quackquacksearch-gui.desktop" "${pkgdir}/usr/share/applications/quackquacksearch-gui.desktop"
    install -Dm644 "${srcdir}/quackquacksearch-krunner.desktop" "${pkgdir}/usr/share/krunner/dbusplugins/quackquacksearch.desktop"

    # 4. Icon
    install -Dm644 "${srcdir}/quackquacksearch.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/quackquacksearch.png"

    # 5. Systemd User Service
    install -Dm644 "${srcdir}/quackquacksearch.service" "${pkgdir}/usr/lib/systemd/user/quackquacksearch.service"

    # 6. License & Documentation
    install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    if [ -f "${srcdir}/README.md" ]; then
        install -Dm644 "${srcdir}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    fi
}
