<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="using:QuackQuackSearch.Core.Config"
        x:Class="QuackQuackSearch.Gui.Views.SettingsWindow"
        Title="QuackQuackSearch - Einstellungen"
        Width="820" Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <TextBlock Grid.Row="0"
                   Text="Überwachte Pfade &amp; Ausgeschlossene Unterordner"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <Grid Grid.Row="1" ColumnDefinitions="*,16,*">
            <!-- Left Column: Monitored Paths -->
            <Grid Grid.Column="0" RowDefinitions="*,Auto">
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource SystemBaseLowColor}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <ListBox Name="PathsListBox"
                             SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="m:PathConfigEntry">
                                <Grid ColumnDefinitions="*,Auto" Margin="4">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Path}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Type}" FontSize="12" Opacity="0.7" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding Enabled}"
                                              Content="Aktiv"
                                              Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Name="AddFolderButton"
                            Content="📁 Ordner hinzufügen..."
                            Padding="10,6"
                            CornerRadius="6" />
                    <Button Name="RemoveFolderButton"
                            Content="🗑️ Entfernen"
                            Padding="10,6"
                            CornerRadius="6" />
                </StackPanel>
            </Grid>

            <!-- Right Column: Exclusions for Selected Path -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto,Auto">
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Ausschlüsse (Unterordner / Muster):" FontWeight="SemiBold" />
                    <TextBlock Name="SelectedPathLabel"
                               Text="Wähle links einen Pfad aus"
                               FontSize="12"
                               Opacity="0.7"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource SystemBaseLowColor}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <ListBox Name="ExcludesListBox"
                             SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="4,2" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <TextBox Name="NewExcludeTextBox"
                             Grid.Column="0"
                             PlaceholderText="Muster oder Unterordner (z.B. secret/ oder *.tmp)"
                             CornerRadius="6"
                             Margin="0,0,8,0" />
                    <Button Name="AddExcludeTextButton"
                            Grid.Column="1"
                            Content="Hinzufügen"
                            Padding="10,6"
                            CornerRadius="6" />
                </Grid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Name="ExcludeFolderPickerButton"
                            Content="📁 Unterordner wählen..."
                            Padding="10,6"
                            CornerRadius="6" />
                    <Button Name="RemoveExcludeButton"
                            Content="🗑️ Ausschluss löschen"
                            Padding="10,6"
                            CornerRadius="6" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Bottom Row: Close Button -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button Name="CloseButton"
                    HorizontalAlignment="Right"
                    Content="Schließen"
                    Padding="16,6"
                    CornerRadius="6" />
        </Grid>

    </Grid>
</Window>
