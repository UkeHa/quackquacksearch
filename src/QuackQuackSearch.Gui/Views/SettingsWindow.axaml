<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="using:QuackQuackSearch.Core.Config"
        x:Class="QuackQuackSearch.Gui.Views.SettingsWindow"
        Title="QuackQuackSearch - Pfadverwaltung"
        Width="680" Height="450"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <TextBlock Grid.Row="0"
                   Text="Überwachte Pfade &amp; Speicherorte"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource SystemBaseLowColor}"
                BorderThickness="1"
                CornerRadius="6">
            <ListBox Name="PathsListBox"
                     SelectionMode="Single">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="m:PathConfigEntry">
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="4">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Path}" FontWeight="Medium" />
                                <TextBlock Text="{Binding Type}" FontSize="12" Opacity="0.7" />
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding Enabled}"
                                      Content="Aktiv"
                                      Margin="12,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,16,0,0">
            <Button Grid.Column="0"
                    Name="AddFolderButton"
                    Content="📁 Ordner hinzufügen..."
                    Padding="12,6"
                    CornerRadius="6" />

            <Button Grid.Column="1"
                    Name="RemoveFolderButton"
                    Content="🗑️ Entfernen"
                    Margin="8,0,0,0"
                    Padding="12,6"
                    CornerRadius="6" />

            <Button Grid.Column="3"
                    Name="CloseButton"
                    Content="Schließen"
                    Padding="16,6"
                    CornerRadius="6" />
        </Grid>

    </Grid>
</Window>
